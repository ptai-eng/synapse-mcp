cmake_minimum_required(VERSION 3.20)
find_package(Git REQUIRED QUIET)
include("${CMAKE_CURRENT_LIST_DIR}/patches/JsonconsManifest.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/patches/SrellManifest.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(fixture "${TEST_BINARY_DIR}/provenance-${run}")
set(prefix include/jsoncons_ext/jsonschema/common)

function(git_command)
    execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture Git operation failed: ${output}${error}")
    endif()
endfunction()
function(qualify source kind expected)
    if(kind STREQUAL "jsoncons")
        set(script ApplyJsonconsPatch.cmake)
        set(variable JSONCONS_SOURCE_DIR)
    else()
        set(script QualifySrell.cmake)
        set(variable SRELL_SOURCE_DIR)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-D${variable}=${source}"
        -P "${CMAKE_CURRENT_LIST_DIR}/${script}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "pass")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Qualified fixture rejected: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Unqualified fixture accepted/wrong error: ${output}${error}")
    endif()
endfunction()
function(restore_jsoncons)
    git_command(-C "${fixture}" -c core.autocrlf=false checkout HEAD -- .)
    foreach(name IN LISTS SYNAPSE_JSONCONS_FILES)
        configure_file("${JSONCONS_SOURCE_DIR}/${prefix}/${name}" "${fixture}/${prefix}/${name}" COPYONLY)
    endforeach()
endfunction()

if(TEST_MODE STREQUAL "idempotent")
    foreach(attempt RANGE 1 2)
        qualify("${JSONCONS_SOURCE_DIR}" jsoncons pass)
    endforeach()
    return()
endif()
git_command(clone --no-hardlinks --no-checkout "${JSONCONS_SOURCE_DIR}" "${fixture}")
git_command(-C "${fixture}" config core.autocrlf false)
git_command(-C "${fixture}" checkout --detach HEAD)
# A pristine tree and the previously qualified NUL-only state both migrate.
qualify("${fixture}" jsoncons pass)
restore_jsoncons()
foreach(name IN LISTS SYNAPSE_JSONCONS_FILES)
    file(APPEND "${fixture}/${prefix}/${name}" "\n// deliberate tamper\n")
    qualify("${fixture}" jsoncons "preimage/postimage mismatch")
    restore_jsoncons()
    git_command(-C "${fixture}" checkout HEAD -- "${prefix}/${name}")
    qualify("${fixture}" jsoncons "preimage/postimage mismatch")
    restore_jsoncons()
    file(READ "${fixture}/${prefix}/${name}" text)
    string(REPLACE "\n" "\r\n" text "${text}")
    file(WRITE "${fixture}/${prefix}/${name}" "${text}")
    qualify("${fixture}" jsoncons "preimage/postimage mismatch")
    restore_jsoncons()
endforeach()
git_command(-C "${fixture}" checkout HEAD -- .)
file(READ "${CMAKE_CURRENT_LIST_DIR}/patches/jsoncons-v1.10.0-pattern-range.patch" patch)
string(REPLACE "\r\n" "\n" patch "${patch}")
file(CONFIGURE OUTPUT "${fixture}-legacy.patch" CONTENT "${patch}" @ONLY NEWLINE_STYLE UNIX)
git_command(-C "${fixture}" apply --unidiff-zero "${fixture}-legacy.patch")
qualify("${fixture}" jsoncons pass)
file(APPEND "${fixture}/include/jsoncons/config/version.hpp" "\n// unrelated tamper\n")
qualify("${fixture}" jsoncons "unrelated edits")
git_command(-C "${fixture}" update-index --assume-unchanged include/jsoncons/config/version.hpp)
qualify("${fixture}" jsoncons "unqualified index flags")
git_command(-C "${fixture}" update-index --no-assume-unchanged include/jsoncons/config/version.hpp)
git_command(-C "${fixture}" update-index --skip-worktree include/jsoncons/config/version.hpp)
qualify("${fixture}" jsoncons "unqualified index flags")
git_command(-C "${fixture}" update-index --no-skip-worktree include/jsoncons/config/version.hpp)
git_command(-C "${fixture}" add include/jsoncons/config/version.hpp)
qualify("${fixture}" jsoncons "staged edits")
git_command(-C "${fixture}" reset HEAD -- include/jsoncons/config/version.hpp)
restore_jsoncons()
file(WRITE "${fixture}/unexpected.hpp" "// unexpected dependency content\n")
qualify("${fixture}" jsoncons "untracked content")
# Keep the rejected fixture as evidence; do not delete source files.
set(srell_fixture "${fixture}-srell")
git_command(clone --no-hardlinks --no-checkout "${SRELL_SOURCE_DIR}" "${srell_fixture}")
git_command(-C "${srell_fixture}" config core.autocrlf false)
git_command(-C "${srell_fixture}" checkout --detach HEAD)
qualify("${srell_fixture}" srell pass)
foreach(name IN LISTS SYNAPSE_SRELL_FILES)
    file(APPEND "${srell_fixture}/${name}" "\n// deliberate tamper\n")
    qualify("${srell_fixture}" srell "unrelated edits")
    git_command(-C "${srell_fixture}" checkout HEAD -- .)
endforeach()
file(WRITE "${srell_fixture}/unexpected.hpp" "// unexpected dependency content\n")
qualify("${srell_fixture}" srell "untracked content")
message(STATUS "All six correction files, migration, mixed/LF/tampered/staged/untracked/unrelated states and SRELL identities qualified")
