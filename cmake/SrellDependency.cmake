include_guard(GLOBAL)
include(FetchContent)
function(synapse_add_srell_dependency)
    if(TARGET synapse_srell OR TARGET srell::srell)
        get_property(owned GLOBAL PROPERTY SYNAPSE_OWNED_SRELL)
        if(NOT owned OR NOT TARGET synapse_srell)
            message(FATAL_ERROR "Pre-existing SRELL target has unqualified provenance")
        endif()
        get_target_property(source synapse_srell SYNAPSE_SRELL_SOURCE_DIR)
    else()
        get_property(declared GLOBAL PROPERTY _FetchContent_synapse_srell_savedDetails SET)
        FetchContent_GetProperties(synapse_srell)
        if(declared OR synapse_srell_POPULATED OR FETCHCONTENT_SOURCE_DIR_SYNAPSE_SRELL)
            message(FATAL_ERROR "Pre-existing SRELL declaration/source override is unqualified")
        endif()
        FetchContent_Declare(synapse_srell
            SOURCE_DIR "${CMAKE_BINARY_DIR}/_deps/synapse_srell-src"
            SOURCE_SUBDIR synapse-no-upstream-cmake
            DOWNLOAD_COMMAND "${CMAKE_COMMAND}" "-DSRELL_SOURCE_DIR=<SOURCE_DIR>" -DSRELL_FETCH_ONLY=ON
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/QualifySrell.cmake")
        FetchContent_MakeAvailable(synapse_srell)
        set(source "${synapse_srell_SOURCE_DIR}")
        add_library(synapse_srell INTERFACE)
        add_library(srell::srell ALIAS synapse_srell)
        target_include_directories(synapse_srell SYSTEM INTERFACE "${source}/srell-src")
        set_property(TARGET synapse_srell PROPERTY SYNAPSE_SRELL_SOURCE_DIR "${source}")
        set_property(GLOBAL PROPERTY SYNAPSE_OWNED_SRELL TRUE)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSRELL_SOURCE_DIR=${source}"
        -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/QualifySrell.cmake" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SRELL dependency qualification failed")
    endif()
endfunction()
