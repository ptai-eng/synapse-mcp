# jsoncons v1.10.0; BSL-1.0 copyright and license stay unchanged.
# ADR-004: only these seven downloaded headers may differ from the pinned tree.
cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyProvenance.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/patches/JsonconsManifest.cmake")
if(NOT DEFINED JSONCONS_SOURCE_DIR)
    message(FATAL_ERROR "JSONCONS_SOURCE_DIR must name the owned checkout")
endif()
get_filename_component(JSONCONS_SOURCE_DIR "${JSONCONS_SOURCE_DIR}" ABSOLUTE)
set(commit "9e57e421285422d7aeeb5aa7dc839f6a19121ee6")
if(JSONCONS_FETCH_ONLY)
    synapse_fetch_checkout("${JSONCONS_SOURCE_DIR}" https://github.com/danielaparker/jsoncons.git "${commit}")
endif()
set(prefix "include/jsoncons_ext/jsonschema")
set(allowed)
foreach(name IN LISTS SYNAPSE_JSONCONS_FILES)
    list(APPEND allowed "${prefix}/${name}")
endforeach()
synapse_verify_checkout("${JSONCONS_SOURCE_DIR}" "${commit}" ${allowed})
set(original TRUE)
set(legacy TRUE)
set(corrected TRUE)
set(six_header TRUE)
set(index 0)
foreach(name IN LISTS SYNAPSE_JSONCONS_FILES)
    if(NOT EXISTS "${JSONCONS_SOURCE_DIR}/${prefix}/${name}")
        message(FATAL_ERROR "jsoncons preimage/postimage mismatch: missing ${name}")
    endif()
    file(SHA256 "${JSONCONS_SOURCE_DIR}/${prefix}/${name}" actual)
    if(NOT actual STREQUAL SYNAPSE_JSONCONS_PRE_${index})
        set(original FALSE)
        if(NOT index EQUAL 0 OR NOT actual STREQUAL "64e377f5b8434231887cfb25cb68cf58e657336c5a65998bc971188c66643fa2")
            set(legacy FALSE)
        endif()
    elseif(index EQUAL 0)
        set(legacy FALSE)
    endif()
    if(NOT actual STREQUAL SYNAPSE_JSONCONS_POST_${index})
        set(corrected FALSE)
    endif()
    if(index LESS 6)
        if(NOT actual STREQUAL SYNAPSE_JSONCONS_POST_${index})
            set(six_header FALSE)
        endif()
    elseif(NOT actual STREQUAL SYNAPSE_JSONCONS_PRE_${index})
        set(six_header FALSE)
    endif()
    math(EXPR index "${index}+1")
endforeach()
if(NOT original AND NOT legacy AND NOT corrected AND NOT six_header)
    message(FATAL_ERROR "jsoncons preimage/postimage mismatch: unknown or mixed correction state (LF required)")
endif()
if(JSONCONS_FETCH_ONLY)
    return()
endif()
if(corrected)
    message(STATUS "jsoncons correction: exact postimage verified; no changes")
    return()
endif()
# Legacy migration first reverses only the independently verified NUL patch.
if(legacy)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/patches/jsoncons-v1.10.0-pattern-range.patch" patch)
    string(REPLACE "\r\n" "\n" patch "${patch}")
    file(CONFIGURE OUTPUT "${JSONCONS_SOURCE_DIR}/../synapse-jsoncons-legacy.patch" CONTENT "${patch}" @ONLY NEWLINE_STYLE UNIX)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.autocrlf=false apply --reverse --unidiff-zero
        "${JSONCONS_SOURCE_DIR}/../synapse-jsoncons-legacy.patch"
        WORKING_DIRECTORY "${JSONCONS_SOURCE_DIR}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "jsoncons verified legacy migration failed")
    endif()
endif()
# ff4fb90's exact six-header postimage needs only the seventh-file patch.
set(patches jsoncons-v1.10.0-dialect-query.patch)
if(NOT six_header)
    list(PREPEND patches jsoncons-v1.10.0-schema.patch)
endif()
foreach(artifact IN LISTS patches)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/patches/${artifact}" patch)
    string(REPLACE "\r\n" "\n" patch "${patch}")
    set(build_patch "${JSONCONS_SOURCE_DIR}/../synapse-${artifact}")
    file(CONFIGURE OUTPUT "${build_patch}" CONTENT "${patch}" @ONLY NEWLINE_STYLE UNIX)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.autocrlf=false apply --unidiff-zero "${build_patch}"
        WORKING_DIRECTORY "${JSONCONS_SOURCE_DIR}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "jsoncons correction apply failed: ${artifact}")
    endif()
endforeach()
set(index 0)
foreach(name IN LISTS SYNAPSE_JSONCONS_FILES)
    file(SHA256 "${JSONCONS_SOURCE_DIR}/${prefix}/${name}" actual)
    if(NOT actual STREQUAL SYNAPSE_JSONCONS_POST_${index})
        message(FATAL_ERROR "jsoncons correction postimage mismatch: ${name}")
    endif()
    math(EXPR index "${index}+1")
endforeach()
message(STATUS "jsoncons correction: pinned preimage and exact postimage verified")
