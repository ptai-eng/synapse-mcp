# Opt in without changing downstream SDK usage:
# -DCMAKE_PROJECT_synapse_mcp_INCLUDE=<absolute path>/cmake/Sanitizers.cmake
include_guard(GLOBAL)
set(SYNAPSE_SANITIZER "none" CACHE STRING "CI instrumentation: none, address-undefined, thread")
set_property(CACHE SYNAPSE_SANITIZER PROPERTY STRINGS none address-undefined thread)
if(NOT SYNAPSE_SANITIZER MATCHES "^(none|address-undefined|thread)$")
    message(FATAL_ERROR "Unknown SYNAPSE_SANITIZER: ${SYNAPSE_SANITIZER}; choose one configuration")
endif()
if(NOT SYNAPSE_SANITIZER STREQUAL "none")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "Requested sanitizer requires the supported GNU/Linux configuration")
    endif()
    if(SYNAPSE_SANITIZER STREQUAL "address-undefined")
        set(_synapse_sanitize_flags -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
    else()
        set(_synapse_sanitize_flags -fsanitize=thread -fno-omit-frame-pointer)
    endif()
    # Check both instrumentation and the runtime. Unsupported runtimes fail closed;
    # a configure that cannot execute its probe is never a successful sanitizer run.
    include(CheckCXXSourceRuns)
    string(JOIN " " CMAKE_REQUIRED_FLAGS ${_synapse_sanitize_flags})
    set(CMAKE_REQUIRED_LINK_OPTIONS ${_synapse_sanitize_flags})
    unset(SYNAPSE_SANITIZER_RUNTIME_WORKS CACHE)
    check_cxx_source_runs("#include <thread>\nint main(){int value=0; std::thread worker([&]{value=1;});worker.join();return value!=1;}"
        SYNAPSE_SANITIZER_RUNTIME_WORKS)
    unset(CMAKE_REQUIRED_FLAGS)
    unset(CMAKE_REQUIRED_LINK_OPTIONS)
    if(NOT SYNAPSE_SANITIZER_RUNTIME_WORKS)
        message(FATAL_ERROR "${SYNAPSE_SANITIZER} runtime probe failed; see CMake configure log. This configuration is not verified.")
    endif()
    add_compile_options(${_synapse_sanitize_flags})
    add_link_options(${_synapse_sanitize_flags})
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RecordEnvironment.cmake")
