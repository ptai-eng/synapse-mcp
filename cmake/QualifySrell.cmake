cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyProvenance.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/patches/SrellManifest.cmake")
if(NOT DEFINED SRELL_SOURCE_DIR)
    message(FATAL_ERROR "SRELL_SOURCE_DIR must name the owned checkout")
endif()
set(commit "f57d6162c7c22844727a1fb42c1d15abe0dfb0d7")
if(SRELL_FETCH_ONLY)
    synapse_fetch_checkout("${SRELL_SOURCE_DIR}" https://github.com/upa-url/srell.git "${commit}")
endif()
synapse_verify_checkout("${SRELL_SOURCE_DIR}" "${commit}")
set(index 0)
foreach(name IN LISTS SYNAPSE_SRELL_FILES)
    if(NOT EXISTS "${SRELL_SOURCE_DIR}/${name}")
        message(FATAL_ERROR "SRELL qualified header/license missing: ${name}")
    endif()
    file(SHA256 "${SRELL_SOURCE_DIR}/${name}" actual)
    if(NOT actual STREQUAL SYNAPSE_SRELL_SHA_${index})
        message(FATAL_ERROR "SRELL source identity mismatch: ${name}")
    endif()
    math(EXPR index "${index}+1")
endforeach()
