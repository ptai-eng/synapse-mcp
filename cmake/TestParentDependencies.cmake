cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
foreach(dependency IN ITEMS jsoncons srell)
    if(dependency STREQUAL "jsoncons")
        set(module JsonconsDependency.cmake)
        set(target jsoncons)
    else()
        set(module SrellDependency.cmake)
        set(target synapse_srell)
    endif()
    foreach(kind IN ITEMS target alias declaration populated override)
        set(fixture "${TEST_BINARY_DIR}/parent-${run}-${dependency}-${kind}")
        if(kind STREQUAL "target")
            set(setup "add_library(${target} INTERFACE)")
        elseif(kind STREQUAL "alias")
            set(setup "add_library(foreign INTERFACE)\nadd_library(${dependency}::${dependency} ALIAS foreign)")
        elseif(kind STREQUAL "declaration")
            set(setup "FetchContent_Declare(synapse_${dependency} SOURCE_DIR ignored)")
        elseif(kind STREQUAL "populated")
            set(setup "FetchContent_SetPopulated(synapse_${dependency} SOURCE_DIR ignored)")
        else()
            string(TOUPPER "${dependency}" upper)
            set(setup "set(FETCHCONTENT_SOURCE_DIR_SYNAPSE_${upper} ignored)")
        endif()
        file(WRITE "${fixture}/CMakeLists.txt"
            "cmake_minimum_required(VERSION 3.20)\nproject(parent NONE)\ninclude(FetchContent)\n${setup}\ninclude(\"${CMAKE_CURRENT_LIST_DIR}/${module}\")\nsynapse_add_${dependency}_dependency()\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/build"
            -G "${TEST_GENERATOR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "unqualified")
            message(FATAL_ERROR "Unqualified parent ${dependency}/${kind} accepted/wrong error: ${output}${error}")
        endif()
    endforeach()
endforeach()
message(STATUS "Foreign dependency targets, aliases, declarations, populated sources and overrides rejected")
